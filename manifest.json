{
  "manifest_version": 3,
  "name": "AimDay",
  "version": "2.1.0",
  "description": "Dump your thoughts — AimDay maps what you want and highlights your next step.",
  "permissions": ["storage", "alarms", "sidePanel", "tabs", "windows", "notifications"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "action": {
    "default_title": "Open AimDay",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
